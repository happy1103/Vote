rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function session(room) {
      return get(/databases/$(database)/documents/sessions/$(room));
    }

    function isHost(room) {
      return signedIn() && session(room).data.hostUid == request.auth.uid;
    }

    function roundDoc(room, roundNumber) {
      return get(/databases/$(database)/documents/sessions/$(room)/rounds/$(roundNumber));
    }

    function voterIdentity() {
      return request.auth.uid + '_voter';
    }

    function hostIdentity() {
      return request.auth.uid + '_host';
    }

    function ownsIdentity(room, identity) {
      return signedIn()
        && (identity == voterIdentity()
            || (identity == hostIdentity() && isHost(room)));
    }

    match /sessions/{room} {
      allow read: if signedIn();

      allow create: if signedIn()
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.status == 'setup'
                    && request.resource.data.currentRound == 1;
      allow update, delete: if isHost(room);

      match /candidates/{candidateId} {
        allow read: if signedIn();
        allow create, update, delete: if isHost(room);
      }

      match /rounds/{roundId} {
        allow read: if signedIn();
        allow create, update, delete: if isHost(room);
      }

      match /participants/{participantId} {
        allow read: if isHost(room)
                    || (signedIn()
                        && (participantId == voterIdentity()
                            || participantId == hostIdentity()));

        allow create, update: if ownsIdentity(room, participantId)
                              && request.resource.data.uid == participantId
                              && ((participantId == voterIdentity()
                                   && request.resource.data.role == 'voter')
                                  || (participantId == hostIdentity()
                                      && request.resource.data.role == 'host'));

        allow delete: if false;
      }

      match /votes/{voteId} {
        allow read: if isHost(room)
                    || (signedIn()
                        && (resource.data.uid == voterIdentity()
                            || resource.data.uid == hostIdentity()));

        allow create: if signedIn()
          && ownsIdentity(room, request.resource.data.uid)
          && ((request.resource.data.uid == voterIdentity()
               && request.resource.data.role == 'voter')
              || (request.resource.data.uid == hostIdentity()
                  && request.resource.data.role == 'host'))
          && request.resource.data.round is int
          && request.resource.data.round >= 1
          && request.resource.data.round <= 5
          && ((request.resource.data.round == 1
               && voteId == ('1_' + request.resource.data.uid))
           || (request.resource.data.round == 2
               && voteId == ('2_' + request.resource.data.uid))
           || (request.resource.data.round == 3
               && voteId == ('3_' + request.resource.data.uid))
           || (request.resource.data.round == 4
               && voteId == ('4_' + request.resource.data.uid))
           || (request.resource.data.round == 5
               && voteId == ('5_' + request.resource.data.uid)))
          && session(room).data.status == 'voting'
          && session(room).data.currentRound == request.resource.data.round
          && roundDoc(room, request.resource.data.round).data.status == 'voting'
          && request.resource.data.choice
             in roundDoc(room, request.resource.data.round).data.options;

        allow update, delete: if false;
      }
    }
  }
}
